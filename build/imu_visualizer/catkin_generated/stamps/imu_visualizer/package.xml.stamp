<?xml version="1.0"?>
<package format="2">
  <name>imu_visualizer</name>
  <version>0.0.0</version>
  <description>The imu_visualizer package</description>

  <maintainer email="dittz-ubuntu@todo.todo">dittz-ubuntu</maintainer>
  <license>BSD</license>

  <!-- Dependencies -->
  <buildtool_depend>catkin</buildtool_depend>
  
  <!-- Add all runtime dependencies -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>

  <!-- Optional, if you want to include additional tools -->
  <export>
    <!-- Export additional information if needed -->
  </export>
</package>

